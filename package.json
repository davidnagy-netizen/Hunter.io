{
  "name": "hunter-io",
  "version": "2.1.0",
  "description": "Funding intelligence for Hungarian companies — live EU and national calls, deterministic eligibility screening and ranked opportunities",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test test/*.test.js tests/*.test.js",
    "build:catalog": "node src/pipeline/buildCatalog.js --live",
    "scrape:open": "python \"scrapers/sedia/funding_tenders_scraper.py\" --type grants --status open --max-records 900 --page-size 100 --output data/raw/eu_open_grants.jsonl",
    "scrape:forthcoming": "python \"scrapers/sedia/funding_tenders_scraper.py\" --type grants --status forthcoming --max-records 900 --page-size 100 --output data/raw/eu_forthcoming_grants.jsonl",
    "scrape:benchmarks": "python \"scrapers/kohesio/kohesio_scraper.py\" --country HU --period 2021-2027 --limit 50 --max-records 400 --fetch-details --output data/raw/kohesio_hungary.jsonl",
    "refresh": "npm run scrape:open && npm run scrape:forthcoming && npm run build:catalog"
  },
  "keywords": [
    "grant-intelligence",
    "hungary",
    "sme",
    "european-union",
    "horizon-europe",
    "funding"
  ],
  "author": "Aetherpontis",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
